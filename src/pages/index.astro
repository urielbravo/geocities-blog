---
import BaseLayout from "../layouts/BaseLayout.astro";

import BlogPost from "../components/BlogPost.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Pagination from "../components/Pagination.astro";
import Sidebar from "../components/Sidebar.astro";

import { POSTS_PER_PAGE } from "../data/blog.ts";
import { paginate, sortedPosts } from "../utils/blog.ts";

// The home page is page 1 of the blog. Later pages live at /blog/page/n/.
const page = paginate(await sortedPosts(), 1, POSTS_PER_PAGE);
---

<BaseLayout>
    <!-- BEGIN .container -->
    <div class="container">
        <Header />

        <!-- BEGIN .page -->
        <div class="page">
            <div class="row">
                <!-- BEGIN .content -->
                <div class="content">
                    <!-- BEGIN .eleven columns -->
                    <div class="columns eleven">
                        <!-- BEGIN .postarea -->
                        <div class="postarea">
                            {page.items.map((post) => <BlogPost post={post} />)}
                            <Pagination
                                currentPage={page.currentPage}
                                totalPages={page.totalPages}
                                basePath="/blog"
                                firstHref="/"
                            />
                        </div>
                        <!-- END .postarea -->
                    </div>
                    <!-- END .eleven columns -->

                    <!-- BEGIN .five columns -->
                    <div class="columns five">
                        <Sidebar />
                    </div>
                    <!-- END .five columns -->
                </div>
                <!-- END .content -->
            </div>
        </div>
        <!-- END .page -->
    </div>
    <!-- END .container -->

    <Footer />
</BaseLayout>
