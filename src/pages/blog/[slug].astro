---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../../components/BlogPost.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Sidebar from "../../components/Sidebar.astro";

import { postHref, sortedPosts } from "../../utils/blog.ts";

// One static route per markdown file in src/content/blog/.
export async function getStaticPaths() {
    const posts = await sortedPosts();
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;

const all = await sortedPosts();
const index = all.findIndex((p) => p.id === post.id);
const newer = index > 0 ? all[index - 1] : null;
const older = index < all.length - 1 ? all[index + 1] : null;
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
    <div class="container">
        <Header />

        <div class="page">
            <div class="row">
                <div class="content">
                    <div class="columns eleven">
                        <div class="postarea full">
                            <BlogPost post={post} full />

                            <nav class="post-navigation" aria-label="More posts">
                                {
                                    older && (
                                        <a
                                            class="previous-post"
                                            href={postHref(older.id)}
                                            rel="prev"
                                        >
                                            &laquo; {older.data.title}
                                        </a>
                                    )
                                }
                                {
                                    newer && (
                                        <a
                                            class="next-post"
                                            href={postHref(newer.id)}
                                            rel="next"
                                        >
                                            {newer.data.title} &raquo;
                                        </a>
                                    )
                                }
                            </nav>

                            <p class="post-date">
                                <a href="/" class="more-link">Back Home</a>
                            </p>
                        </div>
                    </div>

                    <div class="columns five">
                        <Sidebar />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <Footer />
</BaseLayout>
