---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogPost from "../../../components/BlogPost.astro";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import Pagination from "../../../components/Pagination.astro";
import Sidebar from "../../../components/Sidebar.astro";

import { categories, POSTS_PER_PAGE } from "../../../data/blog.ts";
import {
    getCategoryName,
    getPostsByCategory,
    paginate,
    sortedPosts,
} from "../../../utils/blog.ts";

// Catch-all so a category serves both `/category/<slug>/` and, when it has
// more posts than fit on one page, `/category/<slug>/page/n/`.
export async function getStaticPaths() {
    const all = await sortedPosts();

    return categories.flatMap((category) => {
        const inCategory = all.filter(
            (post) => post.data.category === category.slug,
        );
        const totalPages = Math.max(
            1,
            Math.ceil(inCategory.length / POSTS_PER_PAGE),
        );

        return Array.from({ length: totalPages }, (_, i) => ({
            params: {
                slug: category.slug,
                page: i === 0 ? undefined : `page/${i + 1}`,
            },
            props: { slug: category.slug, page: i + 1 },
        }));
    });
}

const { slug, page: requested } = Astro.props;
const page = paginate(await getPostsByCategory(slug), requested, POSTS_PER_PAGE);
const name = getCategoryName(slug);
---

<BaseLayout
    title={`${name} — Page ${page.currentPage}`}
    description={`Posts filed under ${name}.`}
>
    <div class="container">
        <Header />

        <div class="page">
            <div class="row">
                <div class="content">
                    <div class="columns eleven">
                        <div class="postarea">
                            <div class="post page-holder">
                                <div class="article">
                                    <h2 class="headline">{name}</h2>
                                    <div class="post-author">
                                        <p>
                                            {page.totalItems} post{page.totalItems ===
                                            1
                                                ? ""
                                                : "s"}{" "}
                                            filed under this category
                                        </p>
                                    </div>
                                    <span class="divider-small"></span>
                                </div>
                            </div>

                            {
                                page.items.map((post) => (
                                    <BlogPost post={post} />
                                ))
                            }
                            <Pagination
                                currentPage={page.currentPage}
                                totalPages={page.totalPages}
                                basePath={`/category/${slug}`}
                            />
                        </div>
                    </div>

                    <div class="columns five">
                        <Sidebar />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <Footer />
</BaseLayout>
