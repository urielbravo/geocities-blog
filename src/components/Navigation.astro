---
import { mainMenu } from "../data/menu";

import MenuItems from "./MenuItems.astro";

// Mark the item matching this page, so Home isn't highlighted on every route.
// Done here rather than in data/menu.ts because `current` needs Astro.url.
// `current: true` in the data means "this is Home"; any other item is current
// when the request path sits under its href.
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const items = mainMenu.map((item) => ({
    ...item,
    current:
        item.current === true
            ? pathname === "/"
            : pathname.startsWith(item.href.replace(/\/$/, "")),
}));
---

<!-- BEGIN #navigation -->
<nav id="navigation" class="navigation-main clearfix" role="navigation">
    <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
        &#9776;
        <span class="menu-toggle-label">MENU</span>
    </button>

    <div class="menu-main-menu-container">
        <ul id="menu-main-menu" class="menu">
            <MenuItems items={items} />
        </ul>
    </div>
</nav>
<!-- END #navigation -->

<script>
    import { initNavigation } from "./navigation.js";

    initNavigation();
</script>