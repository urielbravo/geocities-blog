---
// `?url` hands back the raw asset path instead of an ImageMetadata object.
// Plain `astro:assets` optimisation would rewrite this GIF to a still WebP and
// throw away every frame but the first, which defeats the point of it.
import torchGif from "../assets/images/torch.gif?url";

interface Props {
    side: "left" | "right";
}

const { side } = Astro.props;
---

<div class={`torch-${side}`}>
    <img
        class="torch"
        src={torchGif}
        alt=""
        width="380"
        height="600"
        loading="eager"
    />
</div>
