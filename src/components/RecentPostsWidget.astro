---
import { getRecentPosts, postHref } from "../utils/blog.ts";

const links = await getRecentPosts(5);
---

<div class="widget widget_recent_entries">
    <h6 class="title">Recent Posts</h6>
    <ul>
        {
            links.map((post) => (
                <li>
                    <a href={postHref(post.id)}>{post.data.title}</a>
                </li>
            ))
        }
    </ul>
</div>
