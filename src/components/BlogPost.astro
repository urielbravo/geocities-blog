---
import type { Post } from "../data/posts";

import { formatDate, getCategoryName, postHref } from "../utils/blog.ts";

import { initBlogPosts } from "./blog-post.js";

interface Props {
    post: Post;
    /** Renders the whole body and no "Read More" link — used on the post page. */
    full?: boolean;
}

const { post, full = false } = Astro.props;
const href = postHref(post.slug);
---

<div class="post blog-holder" id={post.slug}>
    {
        full ? (
            <div
                class="feature-img img-placeholder"
                role="img"
                aria-label={post.imageLabel}
            >
                [ Image 900&times;500 ]
            </div>
        ) : (
            <a
                class="feature-img img-placeholder"
                href={href}
                aria-label={post.imageLabel}
            >
                [ Image 900&times;500 ]
            </a>
        )
    }
    <div class="article">
        <div class="post-date">
            <p>
                <span class="icon" aria-hidden="true">&#9719;</span> Posted on{" "}
                {formatDate(post.date)} in{" "}
                <a href={`/category/${post.category}/`}>
                    {getCategoryName(post.category)}
                </a>
            </p>
        </div>
        <h2 class="headline">
            <a href={href} rel="bookmark">{post.title}</a>
        </h2>
        <span class="divider-small"></span>
        {
            full ? (
                <>
                    {post.content.map((block) =>
                        block.type === "quote" ? (
                            <blockquote>
                                <p>{block.text}</p>
                            </blockquote>
                        ) : block.type === "list" ? (
                            <ul>
                                {block.items.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        ) : (
                            <p>{block.text}</p>
                        ),
                    )}
                </>
            ) : (
                <>
                    <p>{post.excerpt}</p>
                    <a href={href} class="more-link">
                        Read More
                    </a>
                </>
            )
        }
    </div>
</div>

<script>
    import { initBlogPosts } from "./blog-post.js";

    initBlogPosts();
</script>
