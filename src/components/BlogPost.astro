---
import { render } from "astro:content";

import type { BlogPost } from "../utils/blog.ts";

import { formatDate, getCategoryName, postHref } from "../utils/blog.ts";

import { initBlogPosts } from "./blog-post.js";

interface Props {
    post: BlogPost;
    /** Renders the whole body — used on the post page. Listings show the excerpt. */
    full?: boolean;
}

const { post, full = false } = Astro.props;
const { data } = post;
const href = postHref(post.id);

// Only render the markdown when the body is actually needed. Listings take the
// excerpt instead, so there is no point compiling the body there.
let Content;
if (full) {
    ({ Content } = await render(post));
}
---

<div class="post blog-holder" id={post.id}>
    {
        full ? (
            <div
                class="feature-img img-placeholder"
                role="img"
                aria-label={data.imageLabel}
            >
                [ Image 900&times;500 ]
            </div>
        ) : (
            <a
                class="feature-img img-placeholder"
                href={href}
                aria-label={data.imageLabel}
            >
                [ Image 900&times;500 ]
            </a>
        )
    }
    <div class="article">
        <div class="post-date">
            <p>
                <span class="icon" aria-hidden="true">&#9719;</span> Posted on{" "}
                {formatDate(data.date)} in{" "}
                <a href={`/category/${data.category}/`}>
                    {getCategoryName(data.category)}
                </a>
            </p>
        </div>
        <h2 class="headline">
            <a href={href} rel="bookmark">{data.title}</a>
        </h2>
        <span class="divider-small"></span>
        {
            full ? (
                <Content />
            ) : (
                <>
                    <p>{data.excerpt}</p>
                    <a href={href} class="more-link">
                        Read More
                    </a>
                </>
            )
        }
    </div>
</div>

<script>
    import { initBlogPosts } from "./blog-post.js";

    initBlogPosts();
</script>
