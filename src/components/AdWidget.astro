---
// `?url` passes each file through untouched. Astro's optimiser re-encoded these
// as WebP and the output came out *larger* than the sources — the dithered,
// high-contrast artwork is exactly what lossy WebP handles worst.
//
// Filename `vartical_ad2.gif` is misspelled in src/assets/ads/. Left as-is so
// the import matches the file on disk; worth renaming.
import skyscraperAd from "../assets/ads/vartical_ad2.gif?url";
import verticalAd from "../assets/ads/vertical_ad1.gif?url";

/**
 * Mock ad slots — nothing is clickable and no request leaves the page.
 *
 * No `loading="lazy"` here. Two ~15kB GIFs are not worth it, and lazy loading
 * was actively breaking them: these sit ~1700px down the page, so the browser
 * deferred them, then cancelled the in-flight fetch when the surrounding
 * layout shifted. That is the flash-then-vanish.
 *
 * `--ad-w` gives each creative a definite width, so the CSS can derive the
 * height from the aspect ratio and reserve the space before the GIF arrives.
 * Without it the box collapses to its 1px border until the image decodes.
 */
const ads = [
    {
        src: skyscraperAd,
        width: 120,
        height: 600,
        label: "Advertisement: casino bonus offer",
    },
    {
        src: verticalAd,
        width: 150,
        height: 250,
        label: "Advertisement: your ad here, for less than you think",
    },
];
---

<div class="widget widget_ad">
    <h6 class="title">Advertisement</h6>
    <div class="ad-slots">
        {
            ads.map((ad) => (
                <div
                    class="ad-slot"
                    style={`--ad-w:${ad.width}px;--ad-h:${ad.height}px`}
                >
                    <img
                        src={ad.src}
                        alt={ad.label}
                        width={ad.width}
                        height={ad.height}
                        decoding="async"
                    />
                </div>
            ))
        }
    </div>
</div>
