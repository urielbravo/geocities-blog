---
import "../styles/global.css";

import { site } from "../data/site";

interface Props {
    /** Page title. Omitted on the home page, where the site title stands alone. */
    title?: string;
    description?: string;
    bodyClass?: string;
}

const {
    title,
    description = site.metaDescription,
    bodyClass = site.bodyClasses,
} = Astro.props;

// "Post title — Site title" on subpages, just the site title on the home page.
// The tagline stays out of it: it starts with "A blog", which reads badly
// after another title.
const pageTitle = title ? `${title} &mdash; ${site.title}` : site.title;
---

<!doctype html>
<html class="no-js" lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title set:html={pageTitle} />
        <meta name="description" content={description} />
        <!-- Favicon is meatball.png. The .ico is the legacy fallback, generated
             at 16/32/48 with Lanczos; PNG covers every browser since IE11, so
             it's listed last and preferred. -->
        <link rel="icon" href="/favicon.ico" sizes="48x48" />
        <link rel="icon" href="/favicon.png" type="image/png" />
    </head>

    <body class={bodyClass}>
        <!-- BEGIN #wrapper -->
        <div id="wrapper">
            <slot />
        </div>
        <!-- END #wrapper -->
    </body>
</html>

<script>
    import { initSite } from "../scripts/site.js";
    import { initSmoothScroll } from "../scripts/smooth-scroll.js";

    initSite();
    initSmoothScroll();
</script>